generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum VerificationTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  bio          String?  @default("")
  points       Int      @default(0)
  // 邮箱验证:注册后发验证邮件,点击链接置 true。未验证只影响提示,不影响发帖
  emailVerified Boolean  @default(false)
  // 头像 storage 相对路径(storedName);未设置时全站回退到首字母占位
  avatarUrl    String?
  createdAt    DateTime @default(now())

  threads           Thread[]           @relation("ThreadAuthor")
  posts             Post[]             @relation("PostAuthor")
  edits             PostEdit[]         @relation("PostEditor")
  favorites         Favorite[]
  ratings           PostRating[]    @relation("UserRatings")
  moderations       BoardModerator[]
  sentMessages      DirectMessage[]    @relation("DirectMessageSender")
  receivedMessages  DirectMessage[]    @relation("DirectMessageReceiver")
  sessions          Session[]
  attachments       Attachment[]       @relation("AttachmentUploader")
  notifications     Notification[]
  reports           Report[]
  invites           Invite[]           @relation("InviteOwner")
  verificationTokens VerificationToken[]
  bans              Ban[]
  auditLogs          AuditLog[]         @relation("AuditActor")
}

/** 邮箱验证 / 找回密码的一次性令牌:库里只存哈希,明文只在邮件链接里出现一次 */
model VerificationToken {
  id        String                 @id @default(cuid())
  userId    String
  tokenHash String                 @unique
  type      VerificationTokenType
  expiresAt DateTime
  createdAt DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/** 封禁记录:expiresAt 为空 = 永久封禁;解封是把生效中的封禁置为已过期,留档可查 */
model Ban {
  id        String    @id @default(cuid())
  userId    String
  reason    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/** 敏感词表:管理后台增删,内存缓存 1 分钟 */
model SensitiveWord {
  id        String   @id @default(cuid())
  word      String   @unique
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Board {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  threads    Thread[]
  categories ThreadCategory[]
  moderators BoardModerator[]

  @@index([order])
}

/** 主题分类:版块内自定义,可选。分类删除时主题回落为未分类 */
model ThreadCategory {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  threads Thread[]

  @@unique([boardId, name])
  @@index([boardId, order])
}

/** 版主:可管理指定版块的置顶/锁定/删除与举报队列,与全局 ADMIN 互不影响 */
model BoardModerator {
  id        String   @id @default(cuid())
  boardId   String
  userId    String
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

/** 收藏:登录用户收藏主题;收藏者会在该主题有新回复时收到提醒 */
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId, createdAt])
}

/** 楼层评分:每人每层一条,value ±1;可撤销、可改票。reason 为空时只计票 */
model PostRating {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  value     Int       // +1 支持 / -1 反对
  reason    String?
  createdAt DateTime  @default(now())

  post Post @relation("PostRatings", fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("UserRatings", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, value])
}

model Thread {
  id         String   @id @default(cuid())
  boardId    String
  authorId   String
  title      String
  pinned     Boolean  @default(false)
  locked     Boolean  @default(false)
  views      Int      @default(0)
  createdAt  DateTime @default(now())
  // 列表按此字段游标分页,回复时更新
  lastPostAt DateTime @default(now())

  board     Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author    User             @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  category  ThreadCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  posts     Post[]
  favorites Favorite[]

  @@index([boardId, lastPostAt])
  @@index([boardId, categoryId, lastPostAt])
  @@index([pinned])
}

model Post {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  // 只存 Markdown 原文,渲染在读取时做(写时渲染会把脏数据固化进库)
  contentMd String
  createdAt DateTime @default(now())

  thread      Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User         @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  edits       PostEdit[]
  ratings     PostRating[] @relation("PostRatings")

  @@index([threadId, createdAt])
}

/** 帖子编辑历史:每次编辑落一条,旧/新原文都留档 */
model PostEdit {
  id           String   @id @default(cuid())
  postId       String
  editorId     String
  oldContentMd String
  newContentMd String
  createdAt    DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  editor User @relation("PostEditor", fields: [editorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

/** 私信(极简版):无会话模型,直接按收发双方查询 */
model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  contentMd  String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("DirectMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([receiverId, read, createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  postId     String
  uploaderId String
  // 服务端随机生成的相对路径,与用户上传的原始文件名无关
  storedName String   @unique
  fileName   String
  // 入库前经过魔数嗅探,不是浏览器声明的类型
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  uploader User @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("system") // mention | reply | system | report
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String   // thread | post
  targetId   String
  reason     String
  status     String   @default("pending") // pending | resolved | rejected
  createdAt  DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Invite {
  id        String   @id @default(cuid())
  code      String   @unique
  inviterId String
  maxUses   Int      @default(5)
  usedCount Int      @default(0)
  createdAt DateTime @default(now())

  inviter User @relation("InviteOwner", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId])
}

/// 管理后台操作审计:每个 admin action 成功后写一条,后台「审计日志」Tab 展示最近 50 条
/// action 枚举见 src/app/admin/actions.ts 与 threads.ts 的 logger 文案(AUDIT_ACTIONS 集合)。
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String // toggle_pin | toggle_lock | delete_thread | delete_post | set_role | add_points | create_board | delete_board | move_board | review_report
  targetType String // thread | post | user | board | report
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([targetType, targetId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum VerificationTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  bio          String?  @default("")
  points       Int      @default(0)
  // 邮箱验证:注册后发验证邮件,点击链接置 true。未验证只影响提示,不影响发帖
  emailVerified Boolean  @default(false)
  // 通知偏好:按分组控制站内通知;待审/举报/系统等运营类通知不受开关影响(始终送达)
  notifyReply    Boolean @default(true)
  notifyFollow   Boolean @default(true)
  // 邮件提醒：关闭时一切走站内（默认关闭，避免打扰；回复/@/私信合并为一档）
  emailNotify    Boolean @default(false)
  // 头像 storage 相对路径(storedName);未设置时全站回退到首字母占位
  avatarUrl    String?
  registrationIp String?
  lastLoginIp    String?
  lastLoginAt    DateTime?
  lastActiveIp   String?
  lastActiveAt   DateTime?
  createdAt    DateTime @default(now())

  threads           Thread[]           @relation("ThreadAuthor")
  posts             Post[]             @relation("PostAuthor")
  edits             PostEdit[]         @relation("PostEditor")
  favorites         Favorite[]
  ratings           PostRating[]    @relation("UserRatings")
  moderations       BoardModerator[]
  sentMessages      DirectMessage[]    @relation("DirectMessageSender")
  receivedMessages  DirectMessage[]    @relation("DirectMessageReceiver")
  following         Follow[]           @relation("UserFollowers")
  followers         Follow[]           @relation("UserFollowing")
  sessions          Session[]
  attachments       Attachment[]       @relation("AttachmentUploader")
  notifications     Notification[]
  reports           Report[]
  invites           Invite[]           @relation("InviteOwner")
  verificationTokens VerificationToken[]
  bans              Ban[]
  auditLogs          AuditLog[]         @relation("AuditActor")
  medals            UserMedal[]
  following_feed    ReadingProgress[]
  blocksMade        Block[]            @relation("BlockMaker")
  blocksReceived    Block[]            @relation("BlockTarget")
  checkIns          CheckIn[]
  pollVotes         PollVote[]
  ipLogs            UserIpLog[]
}

/** 邮箱验证 / 找回密码的一次性令牌:库里只存哈希,明文只在邮件链接里出现一次 */
model VerificationToken {
  id        String                 @id @default(cuid())
  userId    String
  tokenHash String                 @unique
  type      VerificationTokenType
  // CHANGE_EMAIL 时记录待绑定邮箱
  email     String?
  expiresAt DateTime
  createdAt DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/** 封禁记录:expiresAt 为空 = 永久封禁;解封是把生效中的封禁置为已过期,留档可查 */
model Ban {
  id        String    @id @default(cuid())
  userId    String
  reason    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/** 敏感词表:管理后台增删,内存缓存 1 分钟 */
model SensitiveWord {
  id        String   @id @default(cuid())
  word      String   @unique
  createdAt DateTime @default(now())
}

/** AI 写作(小说生成)独立配置:与站点 AI 自动运营分离,可配不同模型与密钥 */
model WriterSetting {
  id              String   @id @default("writer")
  enabled         Boolean  @default(false)
  baseUrl         String   @default("https://api.deepseek.com/v1")
  model           String   @default("deepseek-chat")
  apiKeyEncrypted String?
  temperature     Float    @default(0.85)
  defaultWords    Int      @default(700)
  defaultStatus   String   @default("approved")
  // 自动追更：定时挑符合条件的作品续写下一章
  autoContinueEnabled       Boolean @default(false)
  autoContinueIntervalHours Int     @default(24)
  autoContinueMaxPerRun     Int     @default(1)
  autoContinueDailyCap      Int     @default(3)
  autoContinueStatus        String  @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/** 全站品牌与 SEO 设置:单例记录,由管理员维护 */
model SiteSetting {
  id             String   @id @default("site")
  siteName       String   @default("SHUAI GAY")
  siteTitle      String   @default("SHUAI GAY 论坛 · 开放 · 克制 · 高效")
  siteDescription String  @default("SHUAI GAY 社区 — 连接兴趣 · 遇见同好 · 分享精彩。综合讨论、技术交流、生活分享与资源互助的极简高性能论坛。")
  logoUrl        String?
  aiAutomationEnabled Boolean @default(false)
  aiBaseUrl      String   @default("https://api.openai.com/v1")
  aiModel        String   @default("gpt-4o-mini")
  aiAutoConfidence Float  @default(0.9)
  aiAdminApiKeyEncrypted    String?
  aiProviderApiKeyEncrypted String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  // 登录设备信息（设置页展示、可远程下线）
  ip         String?
  ua         String?
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model Board {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  order            Int      @default(0)
  isHidden         Boolean  @default(false)
  isLocked         Boolean  @default(false)
  requireApproval  Boolean  @default(false)
  createdAt        DateTime @default(now())

  threads    Thread[]
  categories ThreadCategory[]
  moderators BoardModerator[]

  @@index([order])
}

/** 主题分类:版块内自定义,可选。分类删除时主题回落为未分类 */
model ThreadCategory {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  threads Thread[]

  @@unique([boardId, name])
  @@index([boardId, order])
}

/** 版主:可管理指定版块的置顶/锁定/删除与举报队列,与全局 ADMIN 互不影响 */
model BoardModerator {
  id        String   @id @default(cuid())
  boardId   String
  userId    String
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

/** 关注:单向关注,关注者 followerId → 被关注者 followingId;取关即删除记录 */
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

/** 收藏:登录用户收藏主题;收藏者会在该主题有新回复时收到提醒 */
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  createdAt DateTime @default(now())
  // 追更用：上次查看时该作品的章节数，用于算「有 N 章更新」
  lastSeenPosts Int  @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId, createdAt])
}

/** 楼层评分:每人每层一条,value ±1;可撤销、可改票。reason 为空时只计票 */
model PostRating {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  value     Int       // +1 支持 / -1 反对
  reason    String?
  createdAt DateTime  @default(now())

  post Post @relation("PostRatings", fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("UserRatings", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, value])
}

model Thread {
  id         String   @id @default(cuid())
  boardId    String
  authorId   String
  title      String
  pinned     Boolean  @default(false)
  // 全局置顶:首页置顶区展示;版块内置顶区同时收录全局置顶
  globalPinned Boolean @default(false)
  // 加精:精华主题,列表与详情页挂 badge
  digested     Boolean  @default(false)
  locked     Boolean  @default(false)
  // 允许 AI 自动追更：AI 生成的作品自动开启，手工导入的可在导入时显式开启
  autoContinue Boolean @default(false)
  // 外部迁移幂等键:同一来源记录重试时不重复创建主题
  importKey  String?  @unique
  views      Int      @default(0)
  // approved | pending | deleted（deleted 为软删除，进回收站，30 天后彻底清除）
  status     String   @default("approved")
  createdAt  DateTime @default(now())
  // 列表按此字段游标分页,回复时更新
  lastPostAt DateTime @default(now())

  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  board     Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author    User             @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  category  ThreadCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  posts     Post[]
  favorites Favorite[]
  progress  ReadingProgress[]
  tags      ThreadTag[]
  poll      Poll?

  @@index([boardId, lastPostAt])
  @@index([boardId, categoryId, lastPostAt])
  @@index([pinned])
  @@index([globalPinned])
  @@index([status])
}

model Post {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  // 只存 Markdown 原文,渲染在读取时做(写时渲染会把脏数据固化进库)
  contentMd String
  // approved | pending | deleted（软删除进回收站）
  status    String   @default("approved")
  createdAt DateTime @default(now())
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  thread      Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User         @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  edits       PostEdit[]
  ratings     PostRating[] @relation("PostRatings")

  @@index([threadId, createdAt])
  @@index([status])
}

/** 帖子编辑历史:每次编辑落一条,旧/新原文都留档 */
model PostEdit {
  id           String   @id @default(cuid())
  postId       String
  editorId     String
  oldContentMd String
  newContentMd String
  createdAt    DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  editor User @relation("PostEditor", fields: [editorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

/** 私信(极简版):无会话模型,直接按收发双方查询 */
model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  contentMd  String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("DirectMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([receiverId, read, createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  postId     String
  uploaderId String
  // 服务端随机生成的相对路径,与用户上传的原始文件名无关
  storedName String   @unique
  fileName   String
  // 入库前经过魔数嗅探,不是浏览器声明的类型
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  uploader User @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("system") // mention | reply | system | report
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String   // thread | post
  targetId   String
  reason     String
  status     String   @default("pending") // pending | resolved | rejected
  createdAt  DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Invite {
  id        String   @id @default(cuid())
  code      String   @unique
  inviterId String
  maxUses   Int      @default(5)
  usedCount Int      @default(0)
  createdAt DateTime @default(now())

  inviter User @relation("InviteOwner", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId])
}

model Medal {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String   @default("🏅")
  color       String   @default("#FFF7A8")
  createdAt   DateTime @default(now())

  users UserMedal[]
}

model UserMedal {
  id        String   @id @default(cuid())
  userId    String
  medalId   String
  reason    String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  medal Medal @relation(fields: [medalId], references: [id], onDelete: Cascade)

  @@unique([userId, medalId])
  @@index([userId])
  @@index([medalId])
}

model UserIpLog {
  id        String   @id @default(cuid())
  userId    String
  ip        String
  action    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

/// 管理后台操作审计:每个 admin action 成功后写一条,后台「审计日志」Tab 展示最近 50 条
/// action 枚举见 src/app/admin/actions.ts 与 threads.ts 的 logger 文案(AUDIT_ACTIONS 集合)。
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String // toggle_pin | toggle_lock | delete_thread | delete_post | set_role | add_points | create_board | delete_board | move_board | review_report
  targetType String // thread | post | user | board | report
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([targetType, targetId])
}

/// 站点流量日聚合：按「日期 + 归一化路径 + 国家 + 来源 + 设备」聚合 PV。
/// 地区取自 Cloudflare 的 CF-IPCountry（无需 GeoIP 库）；直连源站时为 XX。
/// UV 走 Redis HyperLogLog（见 src/lib/visit-stats.ts），不落库。
model VisitDaily {
  id       String   @id @default(cuid())
  day      DateTime @db.Date
  path     String
  country  String   @default("XX")
  /// 省/州（Cloudflare CF-Region，需在 CF 后台开启 Add visitor location headers）
  region   String   @default("")
  referrer String   @default("")
  device   String   @default("desktop") // desktop | mobile | bot
  pv       Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([day, path, country, region, referrer, device])
  @@index([day])
  @@index([country, day])
  @@index([region, day])
}

/// 404 / 5xx 聚合：按「日 + 类型 + 路径」计次，另存最后一次的来路与 UA 便于定位
model ErrorDaily {
  id           String   @id @default(cuid())
  day          DateTime @db.Date
  kind         String // 404 | 500
  path         String
  count        Int      @default(0)
  lastAt       DateTime @default(now())
  lastReferrer String   @default("")
  lastUa       String   @default("")

  @@unique([day, kind, path])
  @@index([day])
}

/// 真实用户体验指标（Web Vitals）：按「日 + 指标 + 设备」聚合，good 阈值见 lib/observability.ts
model VitalDaily {
  id        String   @id @default(cuid())
  day       DateTime @db.Date
  metric    String // LCP | INP | CLS | TTFB | FCP
  device    String // mobile | desktop
  count     Int      @default(0)
  sumValue  Float    @default(0)
  goodCount Int      @default(0)
  worst     Float    @default(0)

  @@unique([day, metric, device])
  @@index([day])
}

/// 邮件发送失败留痕（SMTP 挂了后台能看到，不用翻容器日志）
model MailFailure {
  id        String   @id @default(cuid())
  to        String
  subject   String
  error     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 阅读进度：小说记到第几章、普通主题记到最后读的楼层（跨设备）
model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  postId    String?
  /// 小说章节序号（1 起）；普通主题为 0
  chapter   Int      @default(0)
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId, updatedAt])
  @@index([threadId])
}

/// 拉黑/屏蔽：屏蔽后互不可见回帖、私信，也不产生通知
model Block {
  id        String   @id @default(cuid())
  userId    String
  targetId  String
  createdAt DateTime @default(now())

  user   User @relation("BlockMaker", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("BlockTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
  @@index([targetId])
}

/// 每日签到
model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  day       DateTime @db.Date
  points    Int      @default(0)
  streak    Int      @default(1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}

/// 主题标签
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())

  threads ThreadTag[]

  @@index([count])
}

model ThreadTag {
  threadId String
  tagId    String

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@index([tagId])
}

/// 投票帖
model Poll {
  id        String    @id @default(cuid())
  threadId  String    @unique
  question  String
  multiple  Boolean   @default(false)
  closesAt  DateTime?
  createdAt DateTime  @default(now())

  thread  Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  label  String
  order  Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId, order])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionId])
  @@index([pollId])
  @@index([userId])
}

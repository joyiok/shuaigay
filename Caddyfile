# Caddyfile — 反向代理 + 附件直出 + 自动 HTTPS
# 说明:
#  - {$CADDY_DOMAINS} 由 compose.yml 注入,默认与 DOMAIN 一致；可加入 www 等别名，
#    例如 "forum.example.com, www.forum.example.com"。
#    Caddy 会自动向 Let's Encrypt 申请证书并续期,无需手工配置 443。
#  - 本地开发保持 DOMAIN=:80,此时不启用 HTTPS。
#  - SITE_URL 是 Next.js 生成 sitemap / 邮件链接的基地址,务必与 DOMAIN 保持一致,
#    例如 DOMAIN=forum.example.com 时 SITE_URL=https://forum.example.com
#    否则邮件中的验证链接、sitemap 里的 URL 会指向错误域名。
#  - 附件 /uploads/* 由 Caddy 直接 file_server,不经过 Node,节省 1 次反代开销。

{
	servers {
		# ponytail: static Cloudflare ranges; refresh from cloudflare.com/ips if they change.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$CADDY_DOMAINS}

encode gzip zstd

header {
	Strict-Transport-Security "max-age=31536000"
	X-Content-Type-Options "nosniff"
	-Server
}

# 附件:Caddy 直接读盘伺服,不经过 Node
# handle_path 会剥掉 /uploads 前缀,映射到 /srv/uploads/<date>/<文件>,
# 与 UPLOAD_DIR 落盘位置一致(之前用 handle 会多一层 /uploads 导致全 404)
handle_path /uploads/* {
	root * /srv/uploads
	file_server
	header Cache-Control "public, max-age=31536000, immutable"
}

# 匿名读者的文档请求：交给 Cloudflare 边缘缓存 60s（国内用户直接命中香港/圣何塞节点，
# 不必每次回法国源站）。登录用户、RSC/预取请求、需登录态的页面一律不缓存。
@anon_doc {
	method GET
	header Accept *text/html*
	not header Cookie *session=*
	not header RSC *
	not header Next-Router-Prefetch *
	not path /api/* /admin* /settings* /notifications* /messages* /drafts* /invite* /login* /register* /reset* /forgot* /verify-email* /u/*
}
# 健康检查端点直通,便于外部监控直接命中
handle /api/health* {
	reverse_proxy app:3000
}

# 匿名读者的文档请求：下游（源站）返回后再改写缓存头，Cloudflare 边缘可缓存 60s
handle @anon_doc {
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {client_ip}
		header_up -CF-Connecting-IP
		header_down Cache-Control "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
		header_down -Vary
	}
}

# 其余全部反代到 Next.js
handle {
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {client_ip}
		header_up -CF-Connecting-IP
	}
}

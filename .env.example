# ===== 本地开发 =====
# 数据库(本地 compose 起的 postgres,映射在宿主机 5433,避开系统自带的 5432)
DATABASE_URL="postgresql://forum:forum_dev_password@localhost:5433/forum?schema=public"
# Redis(可选:不配或连不上时,限流和在线人数自动降级;映射在宿主机 6380)
REDIS_URL="redis://localhost:6380"
# 站点地址(生成邮件链接 / sitemap 用,必须与 Caddy DOMAIN 一致)
SITE_URL="http://localhost:3000"
# 邮件:留空则仅 console.log 模拟,配置后真实发送(见 src/lib/email.ts)
SMTP_URL=
MAIL_FROM="SHUAI GAY 论坛 <noreply@forum.example.com>"
# 附件
# STORAGE_DRIVER=local:存 UPLOAD_DIR 本地目录(默认);=s3:存 S3 兼容对象存储
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="20"
# —— 以下为 STORAGE_DRIVER=s3 时的配置(S3 兼容:阿里云 OSS / MinIO / 腾讯云 COS 等) ——
# S3 服务端点;MinIO/自建等非 AWS 存储必须填,官方 AWS S3 可留空
# S3_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
S3_ENDPOINT=
# 存储桶名
S3_BUCKET=
S3_REGION="us-east-1"
# 访问密钥(与 S3_ACCESS_KEY_ID / AWS_ACCESS_KEY_ID 等价,二选一即可)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 非 AWS 存储(MinIO/OSS 等)建议 true,且配置了 S3_ENDPOINT 时自动生效
S3_FORCE_PATH_STYLE=
# 注意:s3 配置不全(缺 bucket/密钥)时自动回退 local,服务不会崩

# ===== 生产(compose 使用,部署前必须改密码) =====
POSTGRES_USER=forum
POSTGRES_PASSWORD=forum_dev_password
POSTGRES_DB=forum
# 生产填真实域名(自动 HTTPS);本地测试用 :80
DOMAIN=:80

# ===== 备份 =====
# 默认备份到本机 ./backups/restic;生产改成 b2:桶名:forum-backups
RESTIC_REPOSITORY=/backups/restic
# restic 仓库加密口令,生产必须设强口令且妥善保管(丢了备份即作废)
RESTIC_PASSWORD=dev-only-restic-pass
# 备份任务心跳监控(https://healthchecks.io 的 ping 地址,留空则不上报)
HEALTHCHECK_URL=
# 用 B2 异地备份时填
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# ===== 种子数据(仅初始化) =====
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123

# ===== Cloudflare Turnstile 人机验证(可选:不配置则跳过验证直接放行) =====
# 站点密钥(客户端可见);服务端未配置密钥时不校验
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 服务端密钥,绝不能暴露给浏览器
TURNSTILE_SECRET_KEY=

# ===== 限流阈值(可选,默认值见 src/app/actions/auth.ts 与 threads.ts) =====
# 本地调试或反复跑 e2e 时需调大,避免同 IP 被风控拦截(生产建议保持默认)
# RATE_LIMIT_REGISTER=5    # 注册:同 IP 每小时次数
# RATE_LIMIT_LOGIN=20      # 登录:同 IP 每 10 分钟次数
# RATE_LIMIT_THREAD=5      # 发帖:每用户 / 同 IP 每分钟次数
# RATE_LIMIT_REPLY=10      # 回帖:每用户 / 同 IP 每分钟次数
# RATE_LIMIT_EDIT=10       # 编辑:每用户 / 同 IP 每分钟次数
